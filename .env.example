# Best Roofing Now AI Executive Team
# Copy this file to .env and fill in your values

# ===================
# Database (Supabase Postgres)
# ===================
# The app connects as a plain Postgres client (drizzle-orm/node-postgres) — no
# Supabase-specific features (Auth/Storage/Realtime) are used. Get the pooled
# connection string from your Supabase project: Settings > Database > Connection
# string (Transaction pooler, port 6543). Any Postgres host works the same way;
# Supabase is just what this project is standardized on.
DATABASE_URL=postgresql://[user].[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ===================
# AI - Groq (Llama Models)
# ===================
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Optional: Specify model (defaults to llama-3.3-70b-versatile)
# Available models: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# ===================
# AI - Advisors (CEO, CFO, COO, CMO, CPA, tax, sales, etc.)
# ===================
# Highest-stakes advisors (ceo, cfo, cpa, tax_accountant, tax_lawyer) run on
# Claude. Get your key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model globally or per role (ANTHROPIC_MODEL_<ROLE>,
# e.g. ANTHROPIC_MODEL_CEO=claude-opus-4-1-20250805). Defaults to Claude Sonnet 4.
ANTHROPIC_MODEL=

# The rest of the advisors (coo, cmo, sales_manager, customer_service,
# estimator, project_coordinator) run on an open-weight model via fal.ai's
# OpenAI-compatible router (same router used for AI-drafted messages below;
# no separate account needed if that's already set up). Get a key from
# https://fal.ai/dashboard/keys
FAL_AI_API_KEY=
# Optional fallback if you'd rather call OpenRouter directly instead of fal.ai.
OPENROUTER_API_KEY=
# Optional: override the open model globally or per role (OPEN_MODEL_<ROLE>,
# e.g. OPEN_MODEL_ESTIMATOR=moonshotai/kimi-k2.6). Defaults to z-ai/glm-4.6.
OPEN_MODEL=
# Move a specific advisor between providers without a code change:
# ADVISOR_PROVIDER_<ROLE>=anthropic|open (e.g. ADVISOR_PROVIDER_CEO=open).

# ===================
# JobTread Integration
# ===================
# Get these from JobTread Settings > Integrations > Open API
# API Documentation: https://app.jobtread.com/docs
JOBTREAD_API_KEY=
JOBTREAD_COMPANY_ID=

# ===================
# GoHighLevel Integration
# ===================
# Create a Private Integration in GHL Settings > Integrations > Private Integrations
# API Documentation: https://marketplace.gohighlevel.com/docs/
GHL_PIT_TOKEN=
GHL_LOCATION_ID=
# Optional: signature verification for the inbound webhook at /api/webhooks/gohighlevel
GHL_WEBHOOK_SECRET=

# ===================
# RoofLink Integration (old CRM — read-only)
# ===================
# RoofLink Settings > API Tokens. The hourly sync imports RoofLink clients the
# app doesn't already have from JobTread/GoHighLevel (matched by phone, email
# or street address). Leave blank to skip the RoofLink step.
# API Documentation: https://developers.rooflink.com/
ROOFLINK_API_KEY=

# ===================
# Application Settings
# ===================
# Session secret for Express sessions (generate a random string)
SESSION_SECRET=your-random-secret-here-change-in-production

# Application base URL (for webhooks and redirects)
APP_BASE_URL=http://localhost:3000

# Node environment
NODE_ENV=development

# Server port
PORT=3000

# ===================
# Outreach Automation
# ===================
# Enable/disable the outreach scheduler
ENABLE_OUTREACH=false

# OpenAI API key (for AI personalization)
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Hunter.io API key (for email finding and verification)
# Get from https://hunter.io/api_keys
HUNTER_IO_API_KEY=

# BrightData API key (for web scraping)
# Get from https://brightdata.com/
BRIGHTDATA_API_KEY=

# Instantly.ai API key (for cold email sending)
# Get from https://instantly.ai/
INSTANTLY_API_KEY=
INSTANTLY_WEBHOOK_SECRET=

# ===================
# Google OAuth (team console sign-in)
# ===================
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT=http://localhost:3000/api/auth/login/google/callback
# Comma-separated emails allowed to log in (Phase 1: admins only)
LOGIN_ALLOWLIST=james@bestroofingnow.com,admin@bestroofingnow.com

# ===================
# Google Maps
# ===================
# Server-side key: Geocoding + Static Maps API, used for storm-history lookups
# and canvass address enrichment (server/canvass/routes.ts, server/lib/reports/*).
# Get from https://console.cloud.google.com/apis/credentials — restrict it to
# server IPs, NOT by HTTP referrer.
GOOGLE_MAPS_API_KEY=

# Client-side key: Maps JavaScript API, powers the live canvassing map (canvass
# page's Map view). This ships in the public browser bundle (Vite exposes any
# VITE_-prefixed var to the client) — create a SEPARATE key from the one above,
# restrict it by HTTP referrer (your domain) in Google Cloud Console, and only
# enable "Maps JavaScript API" on it. Without this set, the map view shows a
# "not configured" message instead of crashing.
VITE_GOOGLE_MAPS_API_KEY=

# ===================
# Sync workers (JobTread + Calendar)
# ===================
# Shared secret used to authenticate GET /api/sync/cron (and the existing
# brain-sweep/brain-digest crons). Vercel Cron sends it as
# `Authorization: Bearer <CRON_SECRET>`; manual calls may instead send the
# `x-cron-secret` header. Generate a random string; without a match (or if
# blank/unset) the endpoint returns 401.
CRON_SECRET=

# Morning check-in for sales reps (GET /api/cron/rep-daily-reminder, 8 AM
# Eastern, Mon–Sat). Email and/or text per each rep's notify settings on the
# Team page; texts go through GoHighLevel like team nudges. on (default) |
# dry_run (records what would go, sends nothing) | off.
REP_REMINDERS=on
