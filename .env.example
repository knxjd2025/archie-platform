# Archie
# Copy this file to .env and fill in your values

# ===================
# Database (Supabase Postgres)
# ===================
# The app connects as a plain Postgres client (drizzle-orm/node-postgres) — no
# Supabase-specific features (Auth/Storage/Realtime) are used. Get the pooled
# connection string from your Supabase project: Settings > Database > Connection
# string, SESSION pooler (port 5432), as the archie_app role (see
# docs/archie/01-multi-company.md). Not the transaction pooler (6543): company
# isolation needs per-connection settings, and the app refuses to start on it.
DATABASE_URL=postgresql://archie_app.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ===================
# AI - Groq (Llama Models)
# ===================
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Optional: Specify model (defaults to llama-3.3-70b-versatile)
# Available models: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# ===================
# AI - Advisors (CEO, CFO, COO, CMO, CPA, tax, sales, etc.)
# ===================
# Highest-stakes advisors (ceo, cfo, cpa, tax_accountant, tax_lawyer) run on
# Claude. Get your key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model globally or per role (ANTHROPIC_MODEL_<ROLE>,
# e.g. ANTHROPIC_MODEL_CEO=claude-opus-4-1-20250805). Defaults to Claude Sonnet 4.
ANTHROPIC_MODEL=

# The rest of the advisors (coo, cmo, sales_manager, customer_service,
# estimator, project_coordinator) run on an open-weight model via fal.ai's
# OpenAI-compatible router (same router used for AI-drafted messages below;
# no separate account needed if that's already set up). Get a key from
# https://fal.ai/dashboard/keys
FAL_AI_API_KEY=
# Optional fallback if you'd rather call OpenRouter directly instead of fal.ai.
OPENROUTER_API_KEY=
# Optional: override the open model globally or per role (OPEN_MODEL_<ROLE>,
# e.g. OPEN_MODEL_ESTIMATOR=moonshotai/kimi-k2.6). Defaults to z-ai/glm-4.6.
OPEN_MODEL=
# Move a specific advisor between providers without a code change:
# ADVISOR_PROVIDER_<ROLE>=anthropic|open (e.g. ADVISOR_PROVIDER_CEO=open).

# ===================
# JobTread Integration
# ===================
# Get these from JobTread Settings > Integrations > Open API
# API Documentation: https://app.jobtread.com/docs
JOBTREAD_API_KEY=
JOBTREAD_COMPANY_ID=

# ===================
# GoHighLevel (each company connects its own sub-account in Settings)
# ===================
# There is no app-wide GHL token: an admin connects the company's GHL location
# with a Private Integration token in the app, and gets the company's own
# webhook secret there. This only sets where people open GHL in a browser:
# your white-label domain, so nobody sees GHL's own name.
ARCHIE_GHL_APP_URL=https://app.kynexpro.com

# ===================
# Archie platform
# ===================
# Seals each company's stored integration tokens (AES-256-GCM). 32 random
# bytes, base64: openssl rand -base64 32. Never change it without re-sealing.
ARCHIE_SECRETS_KEY=
# The one company allowed to use the integrations below that still read a
# single account from this file (JobTread, Everee, Twilio, CompanyCam).
# Unset: no company can use them.
ARCHIE_ENV_CREDENTIALS_COMPANY_ID=
# Google Workspace domain-wide delegation, per company: <company id>=<domain>;...
# (needs GOOGLE_SA_EMAIL and GOOGLE_SA_KEY). Unset: no company uses it.
ARCHIE_GOOGLE_DWD=
GOOGLE_SA_EMAIL=
GOOGLE_SA_KEY=
# Bug alerts and the morning bug digest for the people who run Archie.
RESEND_API_KEY=
ARCHIE_OPS_EMAIL=
ARCHIE_MAIL_FROM=Archie <alerts@example.com>
# The operator who may flip the V1/V2 messaging switch. Unset: nobody.
COMMS_VERSION_OWNER=
# The people who run Archie itself and may use the Operator page (list,
# create, pause and resume companies; make sign-in links). Comma separated
# emails; each must also sign in normally (password or Google) as a member of
# some company. Being a company admin never makes anyone an operator.
# Unset or empty: nobody. Removing an email takes effect on the next request.
ARCHIE_OPERATOR_EMAILS=
# How many days a new company's trial lasts. Default 14. Once billing is on
# (STRIPE_SECRET_KEY below), a company whose trial has ended without a card is
# locked until an admin adds one.
ARCHIE_TRIAL_DAYS=14

# ===================
# Billing (Stripe)
# ===================
# Billing is OFF while STRIPE_SECRET_KEY is empty: no lock, no Billing page,
# no Stripe calls. Set all six together. Prices: Solo $149 (1 person), +$99
# for a 2nd person; Team $299 (3 people), +$49 each beyond 3
# (shared/billing/pricing.ts).
# Secret key: Stripe Dashboard > Developers > API keys > Secret key
# (sk_test_... while testing, sk_live_... for real money).
STRIPE_SECRET_KEY=
# Webhook signing secret: Stripe Dashboard > Developers > Webhooks > your
# endpoint (https://<your app>/api/webhooks/stripe) > Signing secret (whsec_...).
STRIPE_WEBHOOK_SECRET=
# The four monthly prices (price_...). Print them with
#   STRIPE_SECRET_KEY=sk_... npx tsx scripts/stripe-setup.ts --yes
# which finds or creates them (lookup keys archie_solo_base_monthly,
# archie_solo_extra_monthly, archie_team_base_monthly, archie_team_extra_monthly).
STRIPE_PRICE_SOLO_BASE=
STRIPE_PRICE_SOLO_EXTRA=
STRIPE_PRICE_TEAM_BASE=
STRIPE_PRICE_TEAM_EXTRA=

# ===================
# Roof Lee link (server/sister, docs/archie/02-roof-lee-link.md)
# ===================
# The secret Archie and Roof Lee share, and nobody else. Generate a fresh one
# for this pair (openssl rand -base64 48) and set the same value on both sides.
# Never copy it from another product or another repository.
# Unset: every request under /api/sister is refused, and nothing about the
# Roof Lee link is switched on.
SISTERS_ARCHIE_SECRET=
# Whether Archie is fit for Roof Lee's customers to be sent into. Roof Lee asks
# before it shows anyone a button or uses any Archie tool. Leave unset (no)
# until the link has been proven with a throwaway test company.
SISTERS_ARCHIE_READY=
# Where Archie tells Roof Lee that something happened (a new lead, a finished
# job): Roof Lee's own address, for example https://my.roofli.app. Must be
# https. Unset: Archie records and sends no news for anyone. Also needs
# SISTERS_ARCHIE_SECRET (the news is signed with it) and CRON_SECRET (the
# scheduled run that tries again after a failure).
ROOFLI_EVENTS_URL=
# Which stage of the production board means "job finished" for Roof Lee.
# Unset: closed_out. Other choices: final_walkthrough, final_invoice.
ROOFLI_JOB_FINISHED_STAGE=

# ===================
# Application Settings
# ===================
# Session secret for Express sessions (generate a random string)
SESSION_SECRET=your-random-secret-here-change-in-production

# Application base URL (for webhooks and redirects; Stripe sends people back
# here after adding a card)
APP_BASE_URL=http://localhost:3000

# Node environment
NODE_ENV=development

# Server port
PORT=3000

# ===================
# Google OAuth (team console sign-in)
# ===================
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT=http://localhost:3000/api/auth/login/google/callback
# Optional, for a private deployment: only these emails may sign in at all.
# Leave empty to let each company's roster decide. LOGIN_BLOCKLIST never may.
LOGIN_ALLOWLIST=
LOGIN_BLOCKLIST=

# ===================
# Google Maps
# ===================
# Server-side key: Geocoding + Static Maps API, used for storm-history lookups
# and canvass address enrichment (server/canvass/routes.ts, server/lib/reports/*).
# Get from https://console.cloud.google.com/apis/credentials — restrict it to
# server IPs, NOT by HTTP referrer.
GOOGLE_MAPS_API_KEY=

# Client-side key: Maps JavaScript API, powers the live canvassing map (canvass
# page's Map view). This ships in the public browser bundle (Vite exposes any
# VITE_-prefixed var to the client) — create a SEPARATE key from the one above,
# restrict it by HTTP referrer (your domain) in Google Cloud Console, and only
# enable "Maps JavaScript API" on it. Without this set, the map view shows a
# "not configured" message instead of crashing.
VITE_GOOGLE_MAPS_API_KEY=

# ===================
# Sync workers (JobTread + Calendar)
# ===================
# Shared secret for the scheduled jobs (/api/cron/*). Vercel Cron sends it as
# `Authorization: Bearer <CRON_SECRET>`; manual calls may instead send the
# `x-cron-secret` header. Generate a random string; without a match (or if
# blank/unset) the endpoint returns 401.
CRON_SECRET=

# Morning check-in for sales reps (GET /api/cron/rep-daily-reminder, 8 AM in
# each company's time zone, Mon to Sat). Email and/or text per each rep's
# notify settings on the Team page, through the company's own GHL. on (default) |
# dry_run (records what would go, sends nothing) | off.
REP_REMINDERS=on

# Roof reports merged from the old program. Off unless exactly "on" (every route is a bare 404 while off).
# Needs migrations 0020, 0021 and 0022 applied first (docs/archie/03-roof-reports.md). Uses the photo store
# (ARCHIE_PHOTOS_*) and the model keys above (GROQ_API_KEY, GEMINI_API_KEY, ANTHROPIC_API_KEY).
ARCHIE_ROOF_REPORTS=
