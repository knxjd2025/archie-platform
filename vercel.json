{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "installCommand": "npm install",
  "framework": null,
  "functions": {
    "api/bundled.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/bundled"
    },
    {
      "source": "/r/(.*)",
      "destination": "/api/bundled"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/set-password",
      "destination": "/index.html"
    },
    {
      "source": "/set-password/",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/agent-chats/cron",
      "schedule": "10,40 * * * *"
    },
    {
      "path": "/api/cron/rep-daily-reminder",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/meetings",
      "schedule": "5,20,35,50 * * * *"
    },
    {
      "path": "/api/cron/seed-companies",
      "schedule": "25 * * * *"
    },
    {
      "path": "/api/cron/sister-events",
      "schedule": "*/10 * * * *"
    }
  ]
}
