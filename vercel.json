{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "installCommand": "npm install",
  "framework": null,
  "functions": {
    "api/bundled.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/bundled"
    },
    {
      "source": "/r/(.*)",
      "destination": "/api/bundled"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/agent-chats/cron",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/rep-daily-reminder",
      "schedule": "0 10-18 * * *"
    },
    {
      "path": "/api/cron/meetings",
      "schedule": "20 * * * *"
    }
  ]
}
