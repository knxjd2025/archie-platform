{
  "name": "best-roofing-ai",
  "version": "1.0.0",
  "description": "AI Executive Team for Best Roofing Now LLC",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "vite build && esbuild api/index.ts --bundle --platform=node --target=node20 --outfile=api/bundled.js --format=cjs --external:pg-native --external:better-sqlite3 --external:vite --external:lightningcss && esbuild server/index.ts --bundle --platform=node --outdir=dist --format=cjs --external:pg-native --external:better-sqlite3 --external:vite --external:lightningcss",
    "start": "node dist/index.js",
    "test": "vitest run",
    "e2e": "scripts/e2e/run.sh",
    "e2e:ui": "E2E_UI=1 scripts/e2e/run.sh",
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "check": "tsc --noEmit",
    "cap:sync": "npx vite build && npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/core": "^8.5.1",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/ios": "^8.5.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-google-maps/api": "^2.20.8",
    "@twilio/voice-sdk": "^2.18.5",
    "@vercel/functions": "3.9.9",
    "compression": "^1.7.4",
    "connect-pg-simple": "^9.0.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.18.2",
    "express-session": "^1.18.0",
    "googleapis": "^170.1.0",
    "helmet": "^8.3.0",
    "intuit-oauth": "^4.2.2",
    "openai": "^4.28.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.11.3",
    "plaid": "^41.1.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ws": "^8.16.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/compression": "^1.7.5",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/node": "^20.11.16",
    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "drizzle-kit": "^0.20.14",
    "esbuild": "^0.20.0",
    "postcss": "^8.4.35",
    "puppeteer-core": "^23.11.1",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vitest": "^4.1.10"
  }
}
